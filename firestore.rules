rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Remplace les adresses ci-dessous par les comptes Google autorisés (un par ligne, entre guillemets, séparés par des virgules).
    function autorise() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "adresse1@gmail.com",
          "adresse2@gmail.com",
          "adresse3@gmail.com"
        ];
    }
    match /players/{id} { allow read, write: if autorise(); }
    match /matches/{id} { allow read, write: if autorise(); }
    match /state/{id}   { allow read, write: if autorise(); }
  }
}
